# Copy to .env and fill in. Never commit the real .env.

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Django secrets: any long random strings
SECRET_KEY=change_me_to_a_long_random_string
JWT_SECRET=change_me_to_another_long_random_string

# Coding round code execution
#   piston = self-hosted Piston sandbox in Docker (recommended)
#   local  = runs code on this machine with a timeout; development only, NOT a sandbox
#   off    = no code runner (e.g. a host without Docker); the coding round is switched off
CODE_EXECUTOR=piston
ALLOW_LOCAL_EXECUTOR=0
PISTON_URL=http://localhost:2000
# Only when Piston runs on another server behind a reverse proxy that checks it:
PISTON_TOKEN=

# Google sign-in (optional). An OAuth "Web application" client ID from Google Cloud Console,
# with your site (e.g. http://localhost:5173) under Authorised JavaScript origins. It is public, not a secret.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Live server only (leave unset for local development):
# DEBUG=False
# ALLOWED_HOSTS=your-backend.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# DATA_DIR=/data                (a persistent volume for the database and the resume vector store)
